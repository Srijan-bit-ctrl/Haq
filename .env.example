# Copy to backend/.env and fill in
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# comma-separated models to try if the main one is busy
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# server-side voice (used when the device has no voice for the language); each model has its own free quota
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# voice input (speech to text): quickest models first; the AI's 'thinking' is switched off for speed
GEMINI_STT_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite

# optional
DATA_DIR=./data
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MIN=40
CORS_ORIGINS=*
